{% extends "layouts/consultant.html.twig" %}

{% set moisNoms = ['Janvier','Fevrier','Mars','Avril','Mai','Juin','Juillet','Aout','Septembre','Octobre','Novembre','Decembre'] %}

{% block title %}Historique - {{ projet.nom }}{% endblock %}

{% block content %}
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Historique — {{ projet.nom }} ({{ annee }})</h5>
      <a href="{{ path('app_consultant_index') }}" class="btn btn-outline-secondary btn-sm">Retour a mes projets</a>
    </div>

    <div class="row g-4 p-4">
      {% for i in 1..12 %}
        {% set facture = factures_par_mois[i] ?? null %}
        <div class="col-lg-3 col-sm-6">
          <div class="card border">
            <div class="card-body text-center">
              <h6 class="mb-2">{{ moisNoms[i - 1] }}</h6>
              {% if facture %}
                {% if facture.statut == 'validee' %}
                  <span class="badge bg-label-success mb-2">Validee</span>
                {% else %}
                  <span class="badge bg-label-warning mb-2">Brouillon</span>
                {% endif %}
                <p class="mb-2 fw-medium">{{ facture.montantTotal|number_format(2, ',', ' ') }} EUR</p>
                <a href="{{ path('app_consultant_facture_show', {id: projet.id, annee: annee, mois: i}) }}" class="btn btn-sm btn-outline-primary w-100">Consulter</a>
              {% else %}
                <span class="badge bg-label-secondary mb-2">Non creee</span>
                <p class="mb-2 text-body-secondary">—</p>
                <a href="{{ path('app_consultant_facture_show', {id: projet.id, annee: annee, mois: i}) }}" class="btn btn-sm btn-outline-secondary w-100">Creer</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endblock %}
