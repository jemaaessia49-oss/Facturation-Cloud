{% extends 'layouts/admin.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block content %}
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Utilisateurs</h5>
      <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">
        <i class="icon-base bx bx-plus me-1"></i> Nouvel utilisateur
      </a>
    </div>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success mx-4 mt-4">{{ message }}</div>
    {% endfor %}

    <div class="table-responsive text-nowrap">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="table-border-bottom-0">
          {% for user in users %}
            <tr>
              <td>{{ user.prenom }} {{ user.nom }}</td>
              <td>{{ user.email }}</td>
              <td>
                {% if 'ROLE_ADMIN' in user.roles %}
                  <span class="badge bg-label-danger">Administrateur</span>
                {% else %}
                  <span class="badge bg-label-info">Consultant</span>
                {% endif %}
              </td>
              <td>
                <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-icon">
                  <i class="icon-base bx bx-edit"></i>
                </a>
                <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                  <button type="submit" class="btn btn-sm btn-icon text-danger">
                    <i class="icon-base bx bx-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="4" class="text-center text-body-secondary py-4">Aucun utilisateur enregistré</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}