{% extends 'layouts/admin.html.twig' %}

{% block title %}Modifier {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block content %}
  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Modifier l'utilisateur</h5>
    </div>
    <div class="card-body">
      {{ form_start(form) }}
        <div class="mb-4">{{ form_row(form.email) }}</div>
        <div class="mb-4">{{ form_row(form.prenom) }}</div>
        <div class="mb-4">{{ form_row(form.nom) }}</div>
        <div class="mb-4">{{ form_row(form.role) }}</div>
        <div class="mb-4">{{ form_row(form.plainPassword) }}</div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">Annuler</a>
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}