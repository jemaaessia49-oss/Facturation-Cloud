{% extends "layouts/admin.html.twig" %}

{% set moisNoms = ['Janvier','Fevrier','Mars','Avril','Mai','Juin','Juillet','Aout','Septembre','Octobre','Novembre','Decembre'] %}

{% block title %}Recherche de factures{% endblock %}

{% block content %}
  <div class="card mb-6">
    <div class="card-header">
      <h5 class="card-title mb-0">Recherche de factures</h5>
    </div>
    <div class="card-body">
      <form method="get" class="row g-3">
        <div class="col-md-3">
          <label class="form-label">Societe</label>
          <select name="societe" class="form-select">
            <option value="">Toutes</option>
            {% for societe in societes %}
              <option value="{{ societe.id }}" {{ criteres.societe == (societe.id ~ '') ? 'selected' : '' }}>{{ societe.nom }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Numero SO</label>
          <input type="text" name="numero_so" value="{{ criteres.numero_so }}" class="form-control" placeholder="Ex: SO-001">
        </div>
        <div class="col-md-2">
          <label class="form-label">Mois</label>
          <select name="mois" class="form-select">
            <option value="">Tous</option>
            {% for i in 1..12 %}
              <option value="{{ i }}" {{ criteres.mois == (i ~ '') ? 'selected' : '' }}>{{ moisNoms[i - 1] }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Annee</label>
          <input type="number" name="annee" value="{{ criteres.annee }}" class="form-control" placeholder="2026">
        </div>
        <div class="col-md-2">
          <label class="form-label">Statut</label>
          <select name="statut" class="form-select">
            <option value="">Tous</option>
            <option value="brouillon" {{ criteres.statut == 'brouillon' ? 'selected' : '' }}>Brouillon</option>
            <option value="validee" {{ criteres.statut == 'validee' ? 'selected' : '' }}>Validee</option>
          </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
          <button type="submit" class="btn btn-primary w-100">
            <i class="icon-base bx bx-search"></i>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Resultats ({{ factures|length }})</h5>
    </div>
    <div class="table-responsive text-nowrap">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Societe</th>
            <th>Projet</th>
            <th>Numero SO</th>
            <th>Periode</th>
            <th>Montant</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="table-border-bottom-0">
          {% for facture in factures %}
            <tr>
              <td>{{ facture.projet.societe.nom }}</td>
              <td>{{ facture.projet.nom }}</td>
              <td>{{ facture.projet.numeroSo }}</td>
              <td>{{ moisNoms[facture.mois - 1] }} {{ facture.annee }}</td>
              <td>{{ facture.montantTotal|number_format(2, ',', ' ') }} EUR</td>
              <td>
                {% if facture.statut == 'validee' %}
                  <span class="badge bg-label-success">Validee</span>
                {% else %}
                  <span class="badge bg-label-warning">Brouillon</span>
                {% endif %}
              </td>
              <td>
                <a href="{{ path('app_admin_facture_show', {id: facture.projet.id, annee: facture.annee, mois: facture.mois}) }}" class="btn btn-sm btn-outline-primary">
                  Consulter
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-center text-body-secondary py-4">Aucun resultat pour ces criteres</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}

