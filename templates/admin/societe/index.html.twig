{% extends "layouts/admin.html.twig" %}

{% block title %}Societes{% endblock %}

{% block content %}
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Societes</h5>
      <a href="{{ path('app_admin_societe_new') }}" class="btn btn-primary">
        <i class="icon-base bx bx-plus me-1"></i> Nouvelle societe
      </a>
    </div>

    <div class="table-responsive text-nowrap">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Informations generales</th>
            <th>Projets</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="table-border-bottom-0">
          {% for societe in societes %}
            <tr>
              <td>{{ societe.nom }}</td>
              <td>{{ societe.informationsGenerales }}</td>
              <td><span class="badge bg-label-info">{{ societe.projets|length }}</span></td>
              <td>
                <a href="{{ path('app_admin_societe_edit', {id: societe.id}) }}" class="btn btn-sm btn-icon">
                  <i class="icon-base bx bx-edit"></i>
                </a>
                <form method="post" action="{{ path('app_admin_societe_delete', {id: societe.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette societe ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_societe_' ~ societe.id) }}">
                  <button type="submit" class="btn btn-sm btn-icon text-danger">
                    <i class="icon-base bx bx-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="4" class="text-center text-body-secondary py-4">Aucune societe enregistree</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
