{% extends 'layouts/admin.html.twig' %}

{% block title %}Nouvelle société{% endblock %}

{% block content %}
  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Nouvelle société</h5>
    </div>
    <div class="card-body">
      {{ form_start(form) }}
        <div class="mb-4">{{ form_row(form.nom) }}</div>
        <div class="mb-4">{{ form_row(form.informationsGenerales) }}</div>

        <button type="submit" class="btn btn-primary">Créer</button>
        <a href="{{ path('app_admin_societe_index') }}" class="btn btn-outline-secondary">Annuler</a>
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}
