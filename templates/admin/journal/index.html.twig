{% extends "layouts/admin.html.twig" %}

{% block title %}Journal des actions{% endblock %}

{% block content %}
  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Journal des actions (100 dernieres)</h5>
    </div>
    <div class="table-responsive text-nowrap">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Date</th>
            <th>Utilisateur</th>
            <th>Action</th>
            <th>Entite</th>
            <th>ID</th>
          </tr>
        </thead>
        <tbody class="table-border-bottom-0">
          {% for log in logs %}
            <tr>
              <td>{{ log.dateAction|date('d/m/Y H:i:s') }}</td>
              <td>{{ log.user ? log.user.email : 'Systeme' }}</td>
              <td>{{ log.action }}</td>
              <td>{{ log.entite }}</td>
              <td>#{{ log.entiteId }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center text-body-secondary py-4">Aucune action enregistree</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
